{
  "name": "@nonogram/app",
  "version": "0.0.0",
  "private": true,
  "description": "Nonogram Revisited PWA (React 19 + Vite 8) running the core solver/generator in a Web Worker",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nonogram/core": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "jsdom": "^26.0.0"
  }
}
